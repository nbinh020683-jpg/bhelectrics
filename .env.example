# Copy this file to .env.local for local development,
# and set these as real environment variables on your Hostinger VPS for production.

# SMTP settings used to send contact-form emails (see src/app/api/contact/route.ts).
# You can use Hostinger's own email hosting (smtp.hostinger.com) or any SMTP provider.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=office@bhelectrics.com
SMTP_PASS=your-mailbox-password

# Where contact-form submissions are sent, and what "from" address is used.
CONTACT_TO_EMAIL=office@bhelectrics.com
CONTACT_FROM_EMAIL=office@bhelectrics.com

# Admin panel login (/admin) — used to manage blog posts.
# Do NOT hand-write these — generate them with:
#   node scripts/generate-admin-credentials.mjs "your-chosen-password"
# and paste the output below exactly as printed (the $ signs in the hash
# must stay escaped as \$ or Next.js will corrupt the value when loading it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Content-bot API key — lets a scheduled/automated job (e.g. a daily Claude
# task) create DRAFT blog posts via POST /api/content-bot/posts. This key can
# only ever create drafts, never publish or delete — a human still reviews
# and publishes every post from /admin/posts. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_BOT_API_KEY=
