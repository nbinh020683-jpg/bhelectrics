# Copy this file to .env.local for local development,
# and set these as real environment variables on your Hostinger hosting for production.

# MySQL database for blog posts (see src/lib/db.ts). Create a database in
# Hostinger hPanel under Databases > MySQL Databases, then use the exact
# host/user/password/name it gives you. This is a real database (not a local
# file), so blog content survives every redeploy.
#
# On Hostinger specifically:
#   - Use 127.0.0.1, NOT "localhost". Node resolves "localhost" to the IPv6
#     address ::1, but the MySQL user is only granted access from the IPv4
#     loopback — using "localhost" causes "Access denied for user ...@'::1'"
#     even with the correct password.
#   - DB_USER and DB_NAME both need the full prefixed form Hostinger creates
#     (e.g. u123456789_bhelectrics), not just the name you typed when
#     creating the database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# SMTP settings used to send contact-form emails (see src/app/api/contact/route.ts).
# You can use Hostinger's own email hosting (smtp.hostinger.com) or any SMTP provider.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=office@bhelectrics.com
SMTP_PASS=your-mailbox-password

# Where contact-form submissions are sent, and what "from" address is used.
CONTACT_TO_EMAIL=office@bhelectrics.com
CONTACT_FROM_EMAIL=office@bhelectrics.com

# Admin panel login (/admin) — used to manage blog posts.
# Do NOT hand-write these — generate them with:
#   node scripts/generate-admin-credentials.mjs "your-chosen-password"
#
# For .env.local (local dev): paste ADMIN_PASSWORD_HASH exactly as printed,
# with the \$ escaping kept — Next.js's own env loader corrupts an unescaped
# $ otherwise.
# For hPanel's Environment Variables UI (production): paste the hash WITHOUT
# the backslashes (plain $2b$12$...). The app also auto-strips any \$ it
# finds at runtime, since Hostinger's own UI has been observed re-adding
# backslashes on save regardless of what you enter — so either form works
# there, but the unescaped one is the more predictable one to start from.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Content-bot API key — lets a scheduled/automated job (e.g. a daily Claude
# task) create DRAFT blog posts via POST /api/content-bot/posts. This key can
# only ever create drafts, never publish or delete — a human still reviews
# and publishes every post from /admin/posts. Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_BOT_API_KEY=
